# ============================================================
# Environment variables — copy to `.env.local` and fill in.
#
# NEVER commit .env or .env.local to source control.
# `NEXT_PUBLIC_` variables are exposed to the browser, so the
# value is a public Formspree endpoint (form ID), never a secret
# API key.
# ============================================================

# Business display name (used in the hero).
NEXT_PUBLIC_SITE_NAME=CS Media Studios

# ============================================================
# Formspree
# ------------------------------------------------------------
# 1. Create a form at https://formspree.io
# 2. Add your email so submissions reach you.
# 3. Set the endpoint to the form's AJAX URL, e.g.:
#    https://formspree.io/f/abcdwxyz
#
# Both the Order/Quote form and the Contact form post here
# (each uses the same endpoint, distinguished by the
# `form-type` hidden field).
# ============================================================
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/abcdwxyz
